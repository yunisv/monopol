# Copy to .env and fill in before running `docker compose up`.
# Never commit the real .env file.

# --- Domain / TLS ---
BASE_DOMAIN=devops.example.com
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$replace$$with$$htpasswd$$hash

# --- Keycloak (SSO for Gitea/OpenProject/Grafana/n8n) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Gitea (VCS + built-in Actions CI) ---
GITEA_DB_PASSWORD=change-me
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=change-me

# --- OpenProject (issue tracking / project management) ---
OPENPROJECT_SECRET_KEY_BASE=change-me-generate-with-openssl-rand-hex-64

# --- SonarQube (code quality/security) ---
SONAR_DB_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- n8n (automation / future AI-agent orchestration) ---
N8N_ENCRYPTION_KEY=change-me-32-chars-min
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
